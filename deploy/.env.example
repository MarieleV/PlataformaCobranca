# Copie para ~/cobranca/.env NA EC2 (nunca versione o .env de produção).
# Permissão restrita:  chmod 600 ~/cobranca/.env

ENVIRONMENT=production

# --- Domínio (o Caddy emite o certificado HTTPS para ele) ---
DOMINIO=cobranca-tcc.duckdns.org

# --- Banco: RDS PostgreSQL 15 (endpoint no console do RDS) ---
# sslmode=require é obrigatório em produção (a API recusa subir sem ele).
# Senha com caracteres especiais (@ : / ? #) precisa ir "URL-encoded".
DATABASE_URL=postgresql://cobranca_app:SENHA_DO_RDS@SEU-ENDPOINT.us-east-2.rds.amazonaws.com:5432/cobranca_db?sslmode=require

# --- RabbitMQ (container local) ---
RABBITMQ_USER=cobranca
RABBITMQ_PASSWORD=

# --- Segurança (gere valores NOVOS, diferentes dos de desenvolvimento) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia em local seguro: sem ela o valor das dívidas fica ilegível.
ENCRYPTION_KEY=

# --- Cookies e CORS ---
# Front e API no MESMO domínio: o CORS só precisa da própria origem.
CORS_ORIGINS=https://cobranca-tcc.duckdns.org
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/auth

AUTO_CREATE_TABLES=false

# --- Administrador inicial (python -m app.seed) ---
ADMIN_EMAIL=admin@consulth.com.br
ADMIN_SENHA_INICIAL=

# --- Régua de cobrança ---
MAX_TENTATIVAS_ENVIO=4
INTERVALO_REENVIO_MINUTOS=30
JANELA_INICIO_HORA=8
JANELA_FIM_HORA=20

# --- Métricas: /metrics não é exposto pelo Caddy; token por garantia ---
METRICS_TOKEN=

# --- Provedores de disparo ---
# Mantenha true até concluir o teste real dos provedores (pendência 2).
ENVIO_SIMULADO=true
SENDGRID_API_KEY=
EMAIL_REMETENTE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
