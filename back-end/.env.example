# Copie para ".env" (que NÃO deve ser versionado) e preencha.

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cobranca_db

# --- RabbitMQ ---
RABBITMQ_USER=cobranca
RABBITMQ_PASSWORD=troque-esta-senha

# --- Segurança ---
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Cookies e CORS ---
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Banco ---
# Mude para false quando o Alembic estiver configurado
AUTO_CREATE_TABLES=false

# --- Régua de cobrança ---
MAX_TENTATIVAS_ENVIO=4
INTERVALO_REENVIO_MINUTOS=30
JANELA_INICIO_HORA=8
JANELA_FIM_HORA=20

# --- Provedores de disparo ---
SENDGRID_API_KEY=
EMAIL_REMETENTE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
